<?xml version="1.0" encoding="UTF-8"?>
<!--
Install on macOS:
1. Copy this file to ~/Library/LaunchAgents/com.tallycfo.scheduler.plist
2. Update ProgramArguments if tally is not on your launchd PATH
3. Run: launchctl load ~/Library/LaunchAgents/com.tallycfo.scheduler.plist
4. Stop it with: launchctl unload ~/Library/LaunchAgents/com.tallycfo.scheduler.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tallycfo.scheduler</string>
  <key>ProgramArguments</key>
  <array>
    <string>tally</string>
    <string>scheduler</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>~/.tally/logs/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>~/.tally/logs/launchd.log</string>
</dict>
</plist>
